{
  "name": "stripe-tiktok-backend",
  "version": "1.0.0",
  "description": "Backend microservices for STRIPE-TIKTOK-REVOLUTION",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "lint": "eslint .",
    "format": "prettier --write",
    "docker:build": "docker build -t stripe-tiktok-backend .",
    "docker:run": "docker run -p 3001:3001 stripe-tiktok-backend"
  },
  "keywords": ["tiktok", "stripe", "video", "social"],
  "author": "abandamarcelmarcelle-png",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.0",
    "redis": "^4.6.10",
    "socket.io": "^4.7.1",
    "socket.io-redis": "^6.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1460.0",
    "axios": "^1.5.0",
    "nodemailer": "^6.9.5",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "node-cron": "^3.0.2",
    "winston": "^3.11.0",
    "prom-client": "^15.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "dotenv-cli": "^7.3.0"
  }
}
